  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Sage pill for the main action on a card (Copy times).",
      "html": "<button class=\"ds-btn-primary\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"8.5\" y=\"8.5\" width=\"11\" height=\"11\" rx=\"2.5\"/><path d=\"M15.5 8.5V6a1.5 1.5 0 0 0-1.5-1.5H6A1.5 1.5 0 0 0 4.5 6v8A1.5 1.5 0 0 0 6 15.5h2.5\"/></svg><span>Copy times</span></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 18px;border:0;border-radius:999px;background:var(--sage,#3E5248);color:var(--on-sage,#F4EDE2);font-family:var(--sans);font-weight:650;font-size:14px;letter-spacing:.005em;cursor:pointer;transition:background-color .2s cubic-bezier(.16,1,.3,1),transform .2s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:var(--sage-press,#33453C)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2.5px solid var(--gold,#C99247);outline-offset:2px}"
    },
    {
      "name": "Band Button",
      "kind": "button",
      "refersTo": "button-on-band",
      "description": "Peach pill used for the primary action when it sits on the sage masthead band (Add zone).",
      "html": "<div style=\"background:#3E5248;padding:16px;border-radius:12px\"><button class=\"ds-btn-band\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg><span>Add zone</span></button></div>",
      "css": ".ds-btn-band{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 18px;border:0;border-radius:999px;background:var(--edge,#E6B089);color:#3A2414;font-family:var(--sans);font-weight:650;font-size:14px;letter-spacing:.005em;cursor:pointer;transition:background-color .2s cubic-bezier(.16,1,.3,1),transform .2s cubic-bezier(.16,1,.3,1)}.ds-btn-band:hover{background:#ECBF9C}.ds-btn-band:active{transform:scale(.97)}.ds-btn-band:focus-visible{outline:2.5px solid var(--gold,#C99247);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet sage text pill for secondary toggles (Edit).",
      "html": "<button class=\"ds-btn-ghost\" aria-pressed=\"false\">Edit</button>",
      "css": ".ds-btn-ghost{min-height:44px;padding:0 14px;border:0;border-radius:999px;background:transparent;color:var(--sage,#3E5248);font-family:var(--sans);font-weight:650;font-size:14px;letter-spacing:.005em;cursor:pointer;transition:background-color .2s cubic-bezier(.16,1,.3,1)}.ds-btn-ghost:hover,.ds-btn-ghost[aria-pressed=true]{background:var(--sage-tint,#E3E9E3)}.ds-btn-ghost:focus-visible{outline:2.5px solid var(--gold,#C99247);outline-offset:2px}"
    },
    {
      "name": "Toolbar (date pill and icon buttons)",
      "kind": "nav",
      "refersTo": "date-pill",
      "description": "Day navigation: circular icon buttons around a cream date pill.",
      "html": "<div class=\"ds-toolbar\"><button class=\"ds-icon-btn\" aria-label=\"Previous day\"><svg viewBox=\"0 0 24 24\"><path d=\"M14.5 6l-6 6 6 6\"/></svg></button><span class=\"ds-date-pill\"><svg viewBox=\"0 0 24 24\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15\" rx=\"3\"/><path d=\"M3.5 10h17M8 3v4M16 3v4\"/></svg>Today, 19 Nov</span><button class=\"ds-icon-btn\" aria-label=\"Next day\"><svg viewBox=\"0 0 24 24\"><path d=\"M9.5 6l6 6-6 6\"/></svg></button></div>",
      "css": ".ds-toolbar{display:flex;align-items:center;gap:6px;padding:12px;background:var(--paper,#F4EDE2)}.ds-toolbar svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-icon-btn{display:inline-grid;place-items:center;width:44px;height:44px;border:0;border-radius:50%;background:var(--card,#FBF7F0);color:var(--sage,#3E5248);box-shadow:0 10px 28px -18px rgba(62,82,72,.45),0 1px 2px rgba(62,82,72,.06);cursor:pointer;transition:transform .2s cubic-bezier(.16,1,.3,1)}.ds-icon-btn:active{transform:scale(.94)}.ds-icon-btn:focus-visible{outline:2.5px solid var(--gold,#C99247);outline-offset:2px}.ds-date-pill{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border-radius:999px;background:var(--card,#FBF7F0);color:var(--ink,#2A2C28);font-family:var(--sans);font-weight:650;font-size:14px;letter-spacing:.005em;box-shadow:0 10px 28px -18px rgba(62,82,72,.45),0 1px 2px rgba(62,82,72,.06)}.ds-date-pill svg{color:var(--sage,#3E5248)}"
    },
    {
      "name": "Suggestion Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Outlined pill for a suggested start time, led by its band mark.",
      "html": "<div style=\"display:flex;gap:8px\"><button class=\"ds-chip\" aria-pressed=\"true\"><span class=\"ds-mark ds-mark-biz\"></span>14:00 <small>All business</small></button><button class=\"ds-chip\" aria-pressed=\"false\"><span class=\"ds-mark ds-mark-edge\"></span>08:30 <small>Edge: Tokyo</small></button></div>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 14px 0 10px;border:1.5px solid var(--line,#E3D8CA);border-radius:999px;background:transparent;color:var(--ink,#2A2C28);font-family:var(--sans);font-weight:650;font-size:14px;letter-spacing:.005em;font-variant-numeric:tabular-nums;cursor:pointer;transition:border-color .2s,background-color .2s}.ds-chip:hover{border-color:#CFC1B0}.ds-chip[aria-pressed=true]{border-color:var(--sage,#3E5248);background:var(--sage-tint,#E3E9E3);color:var(--sage,#3E5248)}.ds-chip:focus-visible{outline:2.5px solid var(--gold,#C99247);outline-offset:2px}.ds-chip small{font-weight:500;font-size:12px;color:var(--muted,#66625A)}.ds-mark{display:inline-block;width:12px;height:12px;border-radius:50%}.ds-mark-biz{background:var(--biz,#56705F)}.ds-mark-edge{background:repeating-linear-gradient(135deg,var(--edge,#E6B089) 0 2px,#A8683C 2px 3.2px)}"
    },
    {
      "name": "Meeting Length Segments",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "Pill radiogroup for meeting length; selected option fills sage.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button role=\"radio\" aria-checked=\"false\">30m</button><button role=\"radio\" aria-checked=\"true\">1h</button><button role=\"radio\" aria-checked=\"false\">1½h</button><button role=\"radio\" aria-checked=\"false\">2h</button></div>",
      "css": ".ds-seg{display:flex;padding:4px;background:var(--paper-deep,#EADFD1);border-radius:999px;max-width:360px}.ds-seg button{flex:1;min-height:38px;border:0;border-radius:999px;background:transparent;color:var(--muted,#66625A);font-family:var(--sans);font-weight:650;font-size:14px;letter-spacing:.005em;font-variant-numeric:tabular-nums;cursor:pointer;transition:background-color .25s cubic-bezier(.16,1,.3,1),color .25s}.ds-seg button[aria-checked=true]{background:var(--sage,#3E5248);color:var(--on-sage,#F4EDE2)}.ds-seg button:not([aria-checked=true]):hover{color:var(--ink,#2A2C28)}.ds-seg button:focus-visible{outline:2.5px solid var(--gold,#C99247);outline-offset:2px}"
    },
    {
      "name": "Meeting Card with Verdict",
      "kind": "card",
      "refersTo": "card",
      "description": "Cream card holding the serif meeting time and a two-channel verdict panel.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-time\">14:00 – 15:00</h2><p class=\"ds-sub\">London time · Thu 19 Nov · 1 h</p><p class=\"ds-verdict\">Business hours for everyone.</p><p class=\"ds-verdict ds-verdict-bad\">Inconvenient for Singapore (00:00).</p></section>",
      "css": ".ds-card{display:grid;gap:14px;max-width:420px;padding:20px 18px 18px;background:var(--card,#FBF7F0);border-radius:22px;box-shadow:0 10px 28px -18px rgba(62,82,72,.45),0 1px 2px rgba(62,82,72,.06);font-family:var(--sans)}.ds-time{margin:0;font:400 34px/1.05 var(--serif);letter-spacing:-.02em;color:var(--sage,#3E5248);font-variant-numeric:lining-nums tabular-nums}.ds-sub{margin:-8px 0 0;font-size:13px;color:var(--muted,#66625A)}.ds-verdict{display:flex;gap:10px;margin:0;padding:11px 14px;border-radius:14px;background:var(--sage-tint,#E3E9E3);color:var(--sage,#3E5248);font-size:14px;font-weight:550;line-height:1.35}.ds-verdict::before{content:\"\";flex:none;width:10px;height:10px;margin-top:4px;border-radius:50%;background:currentColor}.ds-verdict-bad{background:var(--terra-tint,#F6E3D9);color:var(--terra,#A65A3F)}.ds-verdict-bad::before{background:transparent;border:2px solid currentColor}"
    },
    {
      "name": "Day Strip with Selection Bar",
      "kind": "custom",
      "refersTo": "day-strip",
      "description": "Signature: 24h band strip (solid business, hatched edge, pale inconvenient) under the gold selection bar.",
      "html": "<div class=\"ds-tl\"><div class=\"ds-strip\"><i class=\"ds-n\" style=\"width:25%\"></i><i class=\"ds-e\" style=\"width:12.5%\"></i><i class=\"ds-b\" style=\"width:33.3%\"></i><i class=\"ds-e\" style=\"width:12.5%\"></i><i class=\"ds-n\" style=\"width:16.7%\"></i></div><div class=\"ds-sel\"></div></div>",
      "css": ".ds-tl{position:relative;max-width:420px;padding:14px 0 6px}.ds-strip{display:flex;height:30px;border-radius:9px;overflow:hidden;box-shadow:inset 0 0 0 1px var(--night-line,#DDD1C3)}.ds-strip i{height:100%}.ds-b{background:var(--biz,#56705F)}.ds-e{background:repeating-linear-gradient(135deg,var(--edge,#E6B089) 0 5px,var(--edge-hatch,#D99C72) 5px 7px)}.ds-n{background:var(--night,#EBE2D7)}.ds-sel{position:absolute;top:8px;bottom:0;left:45%;width:9%;border:2px solid var(--gold,#C99247);border-radius:12px;box-shadow:0 6px 18px -8px rgba(201,146,71,.55);transition:left .45s cubic-bezier(.16,1,.3,1)}.ds-sel::before{content:\"\";position:absolute;left:50%;top:-12px;width:18px;height:9px;margin-left:-9px;background:var(--gold,#C99247);border-radius:9px 9px 0 0}.ds-tl:hover .ds-sel{left:58%}"
    },
    {
      "name": "Zone Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Warm-paper search well in the bottom sheet; gold ring on focus.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M16 16l4 4\"/></svg><input type=\"search\" placeholder=\"City, country or zone\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;min-height:48px;max-width:420px;padding:0 14px;border-radius:14px;background:var(--paper,#F4EDE2);color:var(--muted,#66625A)}.ds-search:focus-within{outline:2.5px solid var(--gold,#C99247);outline-offset:1px}.ds-search input{flex:1;min-width:0;border:0;background:transparent;font:500 16px var(--sans);color:var(--ink,#2A2C28);outline:none}.ds-search input::placeholder{color:var(--muted,#66625A)}"
    }
