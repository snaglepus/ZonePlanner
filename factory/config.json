{
  "concurrency": 1,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "squash",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "sources": {
    "github": {
      "enabled": true
    },
    "linear": {
      "enabled": true,
      "team": "ZP",
      "operator": "Rob James",
      "marker": "[factory]",
      "done_state": "Done"
    },
    "chat": {
      "enabled": true,
      "mirror": "none"
    }
  },
  "routing": {
    "low": {
      "code": "haiku"
    },
    "medium": {
      "code": "sonnet"
    },
    "high": {
      "code": "sonnet"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "sonnet",
      "ui": "haiku"
    },
    "security": {
      "security": "opus"
    }
  },
  "adversary": {
    "provider": "codex",
    "models": {
      "claude": "fable",
      "codex": "gpt-6-astra"
    },
    "efforts": {
      "claude": null,
      "codex": "high"
    },
    "rounds": {
      "low": 0,
      "medium": 2,
      "high": 4
    },
    "security_min_rounds": 2,
    "security_provider": null,
    "codex_cli": null,
    "timeout_seconds": 900
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    "factory/vendor/*",
    "factory/plans/*"
  ],
  "ports": {
    "base": 5100,
    "step": 10
  },
